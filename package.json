{
  "name": "streetlight",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mock": "node scripts/run-with-env.mjs DEV_MOCK_CHAT=true -- next dev",
    "dev:live": "node scripts/run-with-env.mjs DEV_MOCK_CHAT=false -- next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:audit": "npm audit",
    "check:locales": "node scripts/report-missing-locales.mjs",
    "check:locales:summary": "node scripts/report-missing-locales.mjs --summary",
    "check:launch": "node scripts/check-launch-readiness.mjs",
    "check:content": "node scripts/check-content-contracts.mjs",
    "check:env": "node scripts/check-env-shape.mjs",
    "check:forbidden-integrations": "node scripts/check-forbidden-integrations.mjs",
    "check:no-tracked-secrets": "node scripts/check-no-tracked-secrets.mjs",
    "check:ops": "node scripts/check-ops-tools.mjs",
    "check:response-style": "node scripts/response-style-check.mjs",
    "check:weak-category-recall": "node scripts/weak-category-recall-check.mjs",
    "check:translation-worklist": "node scripts/build-translation-worklist.mjs --check",
    "cost:status": "node scripts/print-cost-mode.mjs",
    "diagnostics:local": "node scripts/print-local-diagnostics.mjs",
    "build:translation-worklist": "node scripts/build-translation-worklist.mjs",
    "validate:data": "node scripts/validate-resource-data.mjs",
    "data:status": "node scripts/print-resource-status.mjs",
    "resources:check": "node scripts/check-resource-sources.mjs",
    "usage:digest": "node scripts/build-usage-digest-email.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:quick": "node scripts/run-with-env.mjs SMOKE_CASE_LIMIT=2 -- node scripts/smoke.mjs",
    "regression:prompts": "node scripts/regression.mjs",
    "regression:stable-core": "node scripts/regression-bucket.mjs stable-core",
    "regression:watchlist": "node scripts/regression-bucket.mjs variance-watchlist",
    "security:harden:quick": "node scripts/security-hardening-autopilot.mjs quick",
    "security:harden:full": "node scripts/security-hardening-autopilot.mjs full",
    "regression:mock": "node scripts/run-with-env.mjs ALLOW_MOCK_REGRESSION=true -- node scripts/regression.mjs",
    "regression:quick": "node scripts/run-with-env.mjs ALLOW_MOCK_REGRESSION=true PROMPT_CASE_LIMIT=3 -- node scripts/regression.mjs",
    "qr:generate": "tsx scripts/generate-qr.ts",
    "outreach:moo:print": "node scripts/export-moo-print-files.mjs",
    "outreach:moo:cards": "npm run outreach:moo:print",
    "incident:new": "node scripts/new-incident.mjs",
    "incident:sev3": "node scripts/append-sev3-note.mjs",
    "ops:status": "node scripts/ops-status.mjs",
    "verify:quick": "npm run lint && npm run build && npm run check:locales:summary && npm run check:translation-worklist && npm run check:content && npm run check:ops && npm run validate:data && npm run diagnostics:local && npm run smoke:quick && npm run regression:quick",
    "verify:mock": "npm run lint && npm run build && npm run check:locales:summary && npm run check:translation-worklist && npm run check:content && npm run check:ops && npm run validate:data && npm run diagnostics:local && npm run smoke && npm run regression:mock",
    "verify": "npm run lint && npm run build && npm run check:locales && npm run check:translation-worklist && npm run check:content && npm run validate:data && npm run smoke && npm run regression:prompts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@vercel/kv": "^3.0.0",
    "docx": "^9.7.1",
    "eslint-plugin-react": "^7.37.5",
    "next": "^16.2.12",
    "pdfmake": "^0.2.23",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/pdfmake": "^0.2.13",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.2",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.14"
  }
}
